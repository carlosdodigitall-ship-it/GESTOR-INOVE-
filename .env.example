# ==============================================================================
# VARIÁVEIS DE AMBIENTE - GESTOR-INOVE / CLOUDZAP
# Configure estas variáveis no painel da Vercel (Project Settings > Environment Variables)
# ==============================================================================

# URL pública da sua aplicação (ex: https://seu-dominio.vercel.app ou https://cloudzapweb.site)
NEXT_PUBLIC_APP_URL=https://cloudzapweb.site

# ------------------------------------------------------------------------------
# SUPABASE (Obrigatório)
# Encontrado em: Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://yfssdwvbghxyeqqhofal.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_byunObufi15FArLjOh9-Cg_BLij9JCb
# Chave secreta de serviço (Role 'service_role' - nunca expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ------------------------------------------------------------------------------
# WHATSAPP Z-API (Obrigatório para mensagens e cobranças automáticas)
# Encontrado em: Painel da Z-API (https://developer.z-api.io)
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=zapi
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=seu_instance_id_da_zapi
ZAPI_TOKEN=seu_token_da_zapi
# Client-Token da Z-API (opcional, caso tenha habilitado segurança por client token)
ZAPI_CLIENT_TOKEN=seu_client_token_opcional

# ------------------------------------------------------------------------------
# E-MAIL TRANSACIONAL (Resend)
# Encontrado em: https://resend.com
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_sua_chave_resend_aqui

# ------------------------------------------------------------------------------
# CRON JOBS / AUTOMAÇÃO DE COBRANÇAS
# Token secreto para proteger o endpoint /api/cron/cobrancas (Vercel Cron)
# ------------------------------------------------------------------------------
CRON_SECRET=seu_segredo_para_cron_aqui

# ------------------------------------------------------------------------------
# P-API (Legado - Mantido apenas para fallback caso não use Z-API)
# ------------------------------------------------------------------------------
PAPI_BASE_URL=https://api.papi.api.br
PAPI_API_KEY=
